# ============================================================================
# DVC Files and Directories
# ============================================================================
# DVC cache and configuration
.dvc/
**/.dvc/
# Note: dvc.lock should be tracked in git for reproducibility
# DVC pointer files (optional - uncomment if you want to ignore them)
# *.dvc
# **/*.dvc

# ============================================================================
# Data Directories (DVC-tracked)
# ============================================================================
# DVC-managed data outputs - tracked via dvc.yaml
# These files/directories are versioned in DVC remote storage, not in git
# All outputs from dvc.yaml stages should be ignored
# DVC project data is located at: dags/dvc_project/data/

# DVC project data directory (all DVC-tracked outputs)
# Ignore all contents of dvc_project/data/ - these are versioned by DVC, not Git
# Ignore all files and subdirectories in dvc_project/data/
dags/dvc_project/data/**

# ============================================================================
# Configuration Files
# ============================================================================
# Keep config JSONs tracked in git
!config/*.json

# Ignore random JSONs at repo root only
/*.json

