# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist/
build/
.venv/
venv/
env/
ENV/
.airflow/
airflow_home/
airflow.db*
logs/
airflow_logs/
*.log
.env
.env.*
.secrets/
gcp-key.json
*.md
README*
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
data/
!data/.gitkeep
!data/**/.gitkeep
tests/
documents/
dags/
scripts/
config/
docker-compose.yml
.dockerignore
deploy/dashboard/
deploy/*.sh
deploy/*.bat
deploy/*.md
deploy/api.log
deploy/test_*.sh

